{
  "PasswordEncryption": {
    "Pepper": "^SafeWord^"
  },
  "FontSettings": {
    "Fonts": [
      {
        "Path": "/Fonts/calibri.ttf",
        "Name": "calibri"
      }
    ]
  },
  "ConnectionStrings": {
    "PostgreConnection": "Host=db;Username=postgres;Password=postgres;Database=Data"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}